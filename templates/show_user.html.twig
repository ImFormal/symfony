{% extends 'base.html.twig' %}

{% block title %}
    {% if account != null %}
        {{ account.firstname }} - {{ account.lastname }}
    {% else %}
        Compte introuvable
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container mx-auto p-4">
        {% if account != null %}
            <h1 class="text-2xl font-bold mb-4">{{ account.firstname }} - {{ account.lastname }}</h1>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="bg-white shadow-lg rounded-lg p-4" id="account-{{ account.id }}">
                    <h2 class="text-xl font-semibold">{{ account.firstname }} {{ account.lastname }}</h2>
                    <p class="text-gray-700">{{ account.email }}</p>
                </div>
            </div>
        {% else %}
            <h1 class="text-2xl font-bold mb-4">Compte introuvable</h1>
        {% endif %}
    </div>
{% endblock %}